*.pem
*.key
*.keystore
*.jks
*.p12
*.pfx
*.p7b
*.p7c
*.der
*.crt
*.cer
*.csr
*.priv
*.private
*_rsa
*_dsa
*_ecdsa
*_ed25519
*_rsa.pub.bak
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*.ppk

# --- SSH ---------------------------------------------------------------
.ssh/id_*
.ssh/*_key
.ssh/known_hosts
.ssh/known_hosts.old
.ssh/authorized_keys
.ssh/agent-*
**/ssh/id_*

